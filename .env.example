# ===== Discord (stickers + GIFs favoritos) =====
# Token de tu cuenta de Discord (NO bot). Sacalo del navegador:
# DevTools (F12) > Network > filtra "api" > una request a discord.com/api
# > Headers > Request Headers > authorization. Copia ese valor aqui.
DISCORD_TOKEN=

# ===== WhatsApp destino =====
# Opcion A: chat normal. Vacio = te lo mandas a ti mismo.
# Formato: numero con codigo pais + @c.us   (ej. 34600111222@c.us)
WA_TARGET_CHAT=

# Opcion B: Canal de WhatsApp (tiene prioridad sobre WA_TARGET_CHAT).
# Link o codigo de invitacion. SOLO admins pueden publicar en un canal.
# ej. https://whatsapp.com/channel/0029Vb...  o solo  0029Vb...
WA_CHANNEL=

# ===== Telegram (stickers) =====
# api_id / api_hash de https://my.telegram.org (API development tools).
TG_API_ID=
TG_API_HASH=
# opcional: tu telefono para no escribirlo cada vez (+34...)
TG_PHONE=
