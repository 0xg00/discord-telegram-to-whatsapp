# ===== Discord (favorite stickers + GIFs) =====
# Your Discord account token (NOT a bot). Grab it from the browser:
# DevTools (F12) > Network > filter "api" > any request to discord.com/api
# > Headers > Request Headers > authorization. Paste that value here.
DISCORD_TOKEN=

# ===== WhatsApp destination =====
# Option A: regular chat. Leave blank to send to yourself.
# Format: number with country code + @c.us   (e.g. 34600111222@c.us)
# For a group use the group jid: <id>@g.us
WA_TARGET_CHAT=

# Option B: WhatsApp Channel (takes precedence over WA_TARGET_CHAT).
# Invite link or invite code. ONLY admins can post to a channel.
# e.g. https://whatsapp.com/channel/0029Vb...  or just  0029Vb...
WA_CHANNEL=

# ===== Telegram (stickers) =====
# api_id / api_hash from https://my.telegram.org (API development tools).
TG_API_ID=
TG_API_HASH=
# optional: your phone number so you don't retype it every time
# E.164 format, e.g. +YOUR_COUNTRY_CODE PHONE  ->  +34600111222
TG_PHONE=
